# Copia este archivo como .env (no se sube a Git) y pon tus datos de MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fiadito
DB_USERNAME=root
DB_PASSWORD=tu_clave_de_mysql
# Clave para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=pon-aqui-una-clave-larga-de-al-menos-32-caracteres
# Opcional: fecha simulada para ensayar casos de prueba (ej. 2026-11-04)
SYSTEM_DATE=
